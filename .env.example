# Application and logging
AMR_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# The selected profile and the alias exposed by llama.cpp must agree.
LLM_PROFILE=fast
LLM_MODEL=qwen3.6-fast
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=dummy
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_GENERATION_TIMEOUT_SECONDS=120
MODEL_GATEWAY_VALIDATE_ON_STARTUP=true

# Local development services
POSTGRES_DSN=postgresql://amr:123456@localhost:5432/amr_agent
QDRANT_URL=http://localhost:6333

