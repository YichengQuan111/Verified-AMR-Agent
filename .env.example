# Application and logging
AMR_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# The selected profile and the alias exposed by llama.cpp must agree.
LLM_PROFILE=fast
LLM_MODEL=qwen3.6-fast
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# 必填，至少 32 字符；与 scripts/start_fast_secure.ps1 使用同一值。
OPENAI_API_KEY=
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_GENERATION_TIMEOUT_SECONDS=120
MODEL_GATEWAY_VALIDATE_ON_STARTUP=true

# Compose/发布密钥均为必填；不要复用 JWT、HITL、Qdrant 或模型 API key。
POSTGRES_USER=amr
POSTGRES_PASSWORD=
POSTGRES_DB=amr_agent
POSTGRES_DSN=
AMR_JWT_SECRET=
AMR_HITL_SIGNING_SECRET=
AMR_JWT_ISSUER=amr-agent
AMR_JWT_AUDIENCE=amr-agent-api
AMR_JWT_LEEWAY_SECONDS=0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# 当前机器可用 E:\Llama.cpp；其他机器必须显式指向包含 models/ 和 llama-server.exe 的目录。
FAST_ARTIFACT_ROOT=E:\Llama.cpp
FAST_MODEL_PATH=
LLAMA_SERVER_PATH=
FAST_MODEL_MANIFEST_PATH=config/fast_model_manifest.json
FAST_MODEL_VERIFY_ARTIFACT=true
AMR_PYTHON_EXE=E:\Anaconda\envs\torch128\python.exe
RAG_COLLECTION_NAME=amr_warehouse_knowledge
RAG_EMBEDDING_MODEL_PATH=E:\Llama.cpp\Embedding
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=8
RAG_CHUNK_MAX_CHARS=1800
RAG_DEFAULT_TOP_K=5
RAG_CANDIDATE_MULTIPLIER=4
RAG_VECTOR_WEIGHT=0.5
RAG_BM25_WEIGHT=0.5
RAG_BM25_SATURATION=3.0
RAG_MINIMUM_HYBRID_SCORE=0.809
RAG_MINIMUM_VECTOR_SCORE=0.499
