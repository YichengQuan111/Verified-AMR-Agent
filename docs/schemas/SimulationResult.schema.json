{
  "$defs": {
    "AMRState": {
      "additionalProperties": false,
      "description": "一台 AMR 在某个确定时刻的完整状态快照。",
      "properties": {
        "amr_id": {
          "description": "AMR 的稳定唯一标识",
          "maxLength": 128,
          "minLength": 1,
          "title": "Amr Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/GridPosition"
        },
        "heading": {
          "$ref": "#/$defs/Heading"
        },
        "battery": {
          "description": "剩余电量百分比",
          "maximum": 100,
          "minimum": 0,
          "title": "Battery",
          "type": "number"
        },
        "load": {
          "description": "当前载荷，单位为千克",
          "minimum": 0,
          "title": "Load",
          "type": "number"
        },
        "task_status": {
          "$ref": "#/$defs/AMRTaskStatus"
        },
        "health_status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "connection_status": {
          "$ref": "#/$defs/ConnectionStatus"
        }
      },
      "required": [
        "amr_id",
        "position",
        "heading",
        "battery",
        "load",
        "task_status",
        "health_status",
        "connection_status"
      ],
      "title": "AMRState",
      "type": "object"
    },
    "AMRTaskStatus": {
      "description": "P0 场景中 AMR 可观测到的任务阶段。",
      "enum": [
        "IDLE",
        "TO_PICKUP",
        "LOADING",
        "TO_DROPOFF",
        "UNLOADING",
        "TO_CHARGE",
        "CHARGING",
        "OFFLINE"
      ],
      "title": "AMRTaskStatus",
      "type": "string"
    },
    "ChargingStationState": {
      "additionalProperties": false,
      "description": "充电站占用和累计供电的结构化快照。",
      "properties": {
        "station_id": {
          "minLength": 1,
          "title": "Station Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/GridPosition"
        },
        "capacity": {
          "title": "Capacity",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ChargingStationStatus"
        },
        "charging_amr_ids": {
          "items": {
            "type": "string"
          },
          "title": "Charging Amr Ids",
          "type": "array"
        },
        "total_energy_delivered_percent": {
          "minimum": 0.0,
          "title": "Total Energy Delivered Percent",
          "type": "number"
        }
      },
      "required": [
        "station_id",
        "position",
        "capacity",
        "status",
        "charging_amr_ids",
        "total_energy_delivered_percent"
      ],
      "title": "ChargingStationState",
      "type": "object"
    },
    "ChargingStationStatus": {
      "description": "充电站在当前 tick 的资源状态。",
      "enum": [
        "available",
        "occupied"
      ],
      "title": "ChargingStationStatus",
      "type": "string"
    },
    "ConnectionStatus": {
      "description": "AMR 与控制系统的连接状态。",
      "enum": [
        "ONLINE",
        "DEGRADED",
        "OFFLINE"
      ],
      "title": "ConnectionStatus",
      "type": "string"
    },
    "ConstraintViolation": {
      "additionalProperties": false,
      "description": "验证器或仿真器发现的一条可定位约束违规。",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "amr_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amr Id"
        },
        "evidence": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "task_id",
        "amr_id",
        "evidence"
      ],
      "title": "ConstraintViolation",
      "type": "object"
    },
    "GridPosition": {
      "additionalProperties": false,
      "description": "30 × 20 仓库栅格中的一个合法位置。\n\n坐标从 0 开始，所以宽度为 30 时 x 最大只能是 29，高度为 20 时 y 最大只能是 19。",
      "properties": {
        "x": {
          "description": "横坐标，允许 0～29",
          "exclusiveMaximum": 30,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "纵坐标，允许 0～19",
          "exclusiveMaximum": 20,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "GridPosition",
      "type": "object"
    },
    "Heading": {
      "description": "AMR 的四个栅格朝向，单位为度。",
      "enum": [
        0,
        90,
        180,
        270
      ],
      "title": "Heading",
      "type": "integer"
    },
    "HealthStatus": {
      "description": "AMR 自检健康状态。",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "FAULT"
      ],
      "title": "HealthStatus",
      "type": "string"
    },
    "JsonValue": {},
    "Observation": {
      "additionalProperties": false,
      "description": "一次工具、仿真、验证或人工操作产生的结构化状态证据。",
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        },
        "source": {
          "$ref": "#/$defs/ObservationSource"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ObservationStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "state_delta": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "State Delta",
          "type": "object"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "tool_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/ConstraintViolation"
          },
          "title": "Violations",
          "type": "array"
        },
        "requires_replan": {
          "title": "Requires Replan",
          "type": "boolean"
        },
        "requires_human": {
          "title": "Requires Human",
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "run_id",
        "task_id",
        "source",
        "observed_at",
        "status",
        "summary",
        "state_delta",
        "evidence_refs",
        "tool_result",
        "violations",
        "requires_replan",
        "requires_human"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationSource": {
      "description": "状态证据的来源。",
      "enum": [
        "tool",
        "simulator",
        "validator",
        "human",
        "system"
      ],
      "title": "ObservationSource",
      "type": "string"
    },
    "ObservationStatus": {
      "description": "一次观测对当前执行的判断。",
      "enum": [
        "ok",
        "warning",
        "error",
        "blocked"
      ],
      "title": "ObservationStatus",
      "type": "string"
    },
    "SimulationEvent": {
      "additionalProperties": false,
      "description": "单个确定性仿真事件。\n\n``time`` 是离散仿真秒，不使用墙上时钟；``payload`` 只保存 JSON 值，便于\n后续 P0-06 events、Trace 和 Eval 直接序列化而不执行任意对象。",
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "simulation_id": {
          "minLength": 1,
          "title": "Simulation Id",
          "type": "string"
        },
        "time": {
          "minimum": 0,
          "title": "Time",
          "type": "integer"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "amr_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amr Id"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Id"
        },
        "workstation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workstation Id"
        },
        "charging_station_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charging Station Id"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "simulation_id",
        "time",
        "event_type",
        "severity",
        "payload"
      ],
      "title": "SimulationEvent",
      "type": "object"
    },
    "SimulationOrderState": {
      "additionalProperties": false,
      "description": "订单的可审计运行态，不修改 P0-04 的 TransportOrder 定义。",
      "properties": {
        "order_id": {
          "minLength": 1,
          "title": "Order Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SimulationOrderStatus"
        },
        "assigned_amr_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assigned Amr Id"
        },
        "payload_kg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payload Kg"
        },
        "pickup_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pickup Time"
        },
        "dropoff_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dropoff Time"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocked Reason"
        }
      },
      "required": [
        "order_id",
        "status",
        "assigned_amr_id",
        "payload_kg",
        "pickup_time",
        "dropoff_time",
        "blocked_reason"
      ],
      "title": "SimulationOrderState",
      "type": "object"
    },
    "SimulationOrderStatus": {
      "description": "订单在仿真中的最小生命周期。",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "blocked"
      ],
      "title": "SimulationOrderStatus",
      "type": "string"
    },
    "SimulationStatus": {
      "description": "仿真终态：完成、故障阻塞或运行到时间上限。",
      "enum": [
        "completed",
        "blocked",
        "timeout"
      ],
      "title": "SimulationStatus",
      "type": "string"
    },
    "ToolError": {
      "additionalProperties": false,
      "description": "工具失败时可序列化、可分类的错误证据。",
      "properties": {
        "category": {
          "$ref": "#/$defs/ToolErrorCategory"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "category",
        "code",
        "message",
        "retryable",
        "details"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolErrorCategory": {
      "description": "稳定错误分类，供后续重试、重规划和人工接管策略使用。",
      "enum": [
        "invalid_argument",
        "permission_denied",
        "timeout",
        "not_found",
        "conflict",
        "unavailable",
        "unsafe_plan",
        "internal"
      ],
      "title": "ToolErrorCategory",
      "type": "string"
    },
    "ToolName": {
      "description": "P0-12 计划实现的九个工具名称；P0-04 仅定义白名单。",
      "enum": [
        "retrieve_knowledge",
        "get_fleet_state",
        "allocate_tasks",
        "plan_multi_amr_routes",
        "validate_fleet_plan",
        "dispatch_simulation",
        "query_execution_state",
        "run_verification_suite",
        "request_approval"
      ],
      "title": "ToolName",
      "type": "string"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "一次工具调用的统一结果、错误和审计证据。",
      "properties": {
        "tool_name": {
          "$ref": "#/$defs/ToolName"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ToolResultStatus"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "effect_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effect Id"
        },
        "tool_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "principal_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Digest"
        },
        "output_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Digest"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "audit_metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Audit Metadata",
          "type": "object"
        }
      },
      "required": [
        "tool_name",
        "call_id",
        "status",
        "output",
        "error",
        "started_at",
        "finished_at",
        "duration_ms",
        "evidence_refs",
        "effect_id"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "ToolResultStatus": {
      "description": "一次工具调用的终态。",
      "enum": [
        "success",
        "failed",
        "timeout",
        "denied"
      ],
      "title": "ToolResultStatus",
      "type": "string"
    },
    "UserRole": {
      "description": "P0 固定的两级工具访问角色。",
      "enum": [
        "viewer",
        "operator"
      ],
      "title": "UserRole",
      "type": "string"
    },
    "WorkstationState": {
      "additionalProperties": false,
      "description": "工位的离散事件状态；容量由 P0-10 计划配置决定。",
      "properties": {
        "workstation_id": {
          "minLength": 1,
          "title": "Workstation Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/GridPosition"
        },
        "capacity": {
          "title": "Capacity",
          "type": "integer"
        },
        "occupied_amr_ids": {
          "items": {
            "type": "string"
          },
          "title": "Occupied Amr Ids",
          "type": "array"
        },
        "last_event_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Event Time"
        },
        "last_event_type": {
          "anyOf": [
            {
              "enum": [
                "pickup",
                "dropoff"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Event Type"
        },
        "service_count": {
          "minimum": 0,
          "title": "Service Count",
          "type": "integer"
        }
      },
      "required": [
        "workstation_id",
        "position",
        "capacity",
        "occupied_amr_ids",
        "last_event_time",
        "last_event_type",
        "service_count"
      ],
      "title": "WorkstationState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "仿真最终快照、Observation 和事件日志。",
  "properties": {
    "simulation_id": {
      "minLength": 1,
      "title": "Simulation Id",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/SimulationStatus"
    },
    "start_time": {
      "title": "Start Time",
      "type": "integer"
    },
    "end_time": {
      "title": "End Time",
      "type": "integer"
    },
    "validation_result": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Validation Result",
      "type": "object"
    },
    "amrs": {
      "items": {
        "$ref": "#/$defs/AMRState"
      },
      "title": "Amrs",
      "type": "array"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/SimulationOrderState"
      },
      "title": "Orders",
      "type": "array"
    },
    "workstations": {
      "items": {
        "$ref": "#/$defs/WorkstationState"
      },
      "title": "Workstations",
      "type": "array"
    },
    "charging_stations": {
      "items": {
        "$ref": "#/$defs/ChargingStationState"
      },
      "title": "Charging Stations",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/SimulationEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "simulation_id",
    "seed",
    "status",
    "start_time",
    "end_time",
    "validation_result",
    "amrs",
    "orders",
    "workstations",
    "charging_stations",
    "observations",
    "events"
  ],
  "title": "SimulationResult",
  "type": "object"
}
