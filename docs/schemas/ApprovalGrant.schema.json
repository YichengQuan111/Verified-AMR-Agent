{
  "additionalProperties": false,
  "description": "审批通过后由存储层签发的、只能用于同一计划/Validator 的授权票据。",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "approval_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "approved_by": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "approved_role": {
      "const": "operator",
      "default": "operator",
      "title": "Approved Role",
      "type": "string"
    },
    "decision": {
      "const": "approved",
      "default": "approved",
      "title": "Decision",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "validator_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validator Digest",
      "type": "string"
    },
    "validator_status": {
      "const": "valid",
      "default": "valid",
      "title": "Validator Status",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "signature": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Signature",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "run_id",
    "task_id",
    "plan_version",
    "approved_by",
    "request_digest",
    "plan_digest",
    "validator_digest",
    "approved_at",
    "expires_at",
    "signature"
  ],
  "title": "ApprovalGrant",
  "type": "object"
}
