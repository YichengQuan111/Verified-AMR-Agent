{
  "$defs": {
    "EvalCategory": {
      "description": "P0-18 五个固定评测分区及其验收配额。",
      "enum": [
        "normal_order_charging",
        "rag_permission_approval",
        "exception_local_replan",
        "verification",
        "prompt_injection_security"
      ],
      "title": "EvalCategory",
      "type": "string"
    },
    "EvalOutcome": {
      "description": "可观察的场景终态；拒绝/阻塞也是合法且可验收的终态。",
      "enum": [
        "completed",
        "charged",
        "answered",
        "denied",
        "blocked",
        "verified",
        "failed"
      ],
      "title": "EvalOutcome",
      "type": "string"
    },
    "FairnessEvidence": {
      "additionalProperties": false,
      "description": "证明三种策略共享数据集、工具、安全门禁和预算包络。\n\n在线独立 ReAct 使用专用控制 Prompt，因此 ``same_prompts`` 只记录事实，\n不再作为硬门禁。``react_uses_pevr_runner`` 必须为 false。",
      "properties": {
        "dataset_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Dataset Version",
          "type": "string"
        },
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "case_id_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Id Digest",
          "type": "string"
        },
        "model_profile": {
          "const": "fast",
          "default": "fast",
          "title": "Model Profile",
          "type": "string"
        },
        "model_alias": {
          "const": "qwen3.6-fast",
          "default": "qwen3.6-fast",
          "title": "Model Alias",
          "type": "string"
        },
        "prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Prompt Versions",
          "type": "object"
        },
        "tool_spec_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Tool Spec Versions",
          "type": "object"
        },
        "p018_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "P018 Config Sha256",
          "type": "string"
        },
        "p019_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "P019 Config Sha256",
          "type": "string"
        },
        "p018_source_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "P018 Source Report Sha256",
          "type": "string"
        },
        "same_dataset": {
          "title": "Same Dataset",
          "type": "boolean"
        },
        "same_tools": {
          "title": "Same Tools",
          "type": "boolean"
        },
        "same_prompts": {
          "title": "Same Prompts",
          "type": "boolean"
        },
        "same_config": {
          "title": "Same Config",
          "type": "boolean"
        },
        "same_model": {
          "title": "Same Model",
          "type": "boolean"
        },
        "same_shared_context_contract": {
          "default": true,
          "title": "Same Shared Context Contract",
          "type": "boolean"
        },
        "same_initial_retrieval": {
          "default": true,
          "title": "Same Initial Retrieval",
          "type": "boolean"
        },
        "same_safety_gates": {
          "default": true,
          "title": "Same Safety Gates",
          "type": "boolean"
        },
        "same_budget_envelope": {
          "default": true,
          "title": "Same Budget Envelope",
          "type": "boolean"
        },
        "strategy_prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Strategy Prompt Versions",
          "type": "object"
        },
        "react_uses_pevr_runner": {
          "const": false,
          "default": false,
          "title": "React Uses Pevr Runner",
          "type": "boolean"
        },
        "react_production_path_touched": {
          "const": false,
          "default": false,
          "title": "React Production Path Touched",
          "type": "boolean"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "case_count",
        "case_id_digest",
        "prompt_versions",
        "tool_spec_versions",
        "p018_config_sha256",
        "p019_config_sha256",
        "p018_source_report_sha256",
        "same_dataset",
        "same_tools",
        "same_prompts",
        "same_config",
        "same_model"
      ],
      "title": "FairnessEvidence",
      "type": "object"
    },
    "JsonValue": {},
    "LatencySummary": {
      "additionalProperties": false,
      "description": "按逐例总延迟计算的 P50/P95，并保留延迟来源和墙钟语义。",
      "properties": {
        "observed": {
          "default": true,
          "title": "Observed",
          "type": "boolean"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "total_ms": {
          "minimum": 0,
          "title": "Total Ms",
          "type": "number"
        },
        "mean_case_ms": {
          "minimum": 0,
          "title": "Mean Case Ms",
          "type": "number"
        },
        "p50_case_ms": {
          "minimum": 0,
          "title": "P50 Case Ms",
          "type": "number"
        },
        "p95_case_ms": {
          "minimum": 0,
          "title": "P95 Case Ms",
          "type": "number"
        },
        "max_case_ms": {
          "minimum": 0,
          "title": "Max Case Ms",
          "type": "number"
        },
        "source": {
          "default": "p018_trace",
          "enum": [
            "p018_trace",
            "p018_independent_oracle",
            "online_wall_clock"
          ],
          "title": "Source",
          "type": "string"
        },
        "wall_clock": {
          "default": false,
          "title": "Wall Clock",
          "type": "boolean"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "sample_count",
        "total_ms",
        "mean_case_ms",
        "p50_case_ms",
        "p95_case_ms",
        "max_case_ms",
        "note"
      ],
      "title": "LatencySummary",
      "type": "object"
    },
    "P019ExecutionMode": {
      "description": "P0-19 允许的执行模式。\n\n``offline_independent_oracle`` 是发布验收：三种策略各自执行同一 60 例。\n``offline_trace_replay`` 仅保留为可视化/步数投影，不能再当作策略质量对照。",
      "enum": [
        "offline_independent_oracle",
        "offline_trace_replay",
        "online_fast_three_strategy_closed_loop"
      ],
      "title": "P019ExecutionMode",
      "type": "string"
    },
    "P019Strategy": {
      "description": "三种对照策略；ReAct 只允许出现在评测层。\n\n``plan_execute`` 是“LLM 一次性产出任务 DAG → 确定性执行器跑完 → 不重规划”\n的 Plan-and-Execute 臂；它与 ``pevr`` 共用同一张八阶段图和同一套 Prompt，\n只差 ``fault_recovery_enabled``，因此二者构成 verify→replan 环的消融。\n``react`` 是唯一真正的跨范式对照（独立循环、独立 Prompt、不产出 DAG）。",
      "enum": [
        "plan_execute",
        "react",
        "pevr"
      ],
      "title": "P019Strategy",
      "type": "string"
    },
    "ResourceObservation": {
      "additionalProperties": false,
      "description": "记录资源是否真的被采样；没有样本时所有数值保持 ``None``。\n\nP0-18 离线 Trace 没有 CPU、RSS 或 GPU 采样。用显式 ``observed=false`` 而不是\n填 0，避免把“没有测量”误读为“消耗为零”；未来在线 adapter 可复用同一字段。",
      "properties": {
        "observed": {
          "default": false,
          "title": "Observed",
          "type": "boolean"
        },
        "sample_count": {
          "default": 0,
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "cpu_time_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Time Ms"
        },
        "peak_rss_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Rss Mb"
        },
        "peak_gpu_memory_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Gpu Memory Mb"
        },
        "source": {
          "default": "not_observed",
          "enum": [
            "p018_trace",
            "online_sampler",
            "not_observed"
          ],
          "title": "Source",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "ResourceObservation",
      "type": "object"
    },
    "SmartComparisonStatus": {
      "description": "Smart 对照的事实状态，明确区分延期和已完成。",
      "enum": [
        "deferred"
      ],
      "title": "SmartComparisonStatus",
      "type": "string"
    },
    "SmartDeferral": {
      "additionalProperties": false,
      "description": "Smart 模型对照的延期记录；所有字段固定为未启动/未完成。",
      "properties": {
        "alias": {
          "const": "qwen3.8-smart",
          "default": "qwen3.8-smart",
          "title": "Alias",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SmartComparisonStatus",
          "default": "deferred"
        },
        "requested_case_count": {
          "default": 15,
          "minimum": 0,
          "title": "Requested Case Count",
          "type": "integer"
        },
        "started": {
          "const": false,
          "default": false,
          "title": "Started",
          "type": "boolean"
        },
        "completed": {
          "const": false,
          "default": false,
          "title": "Completed",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "backlog_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Backlog Key",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "backlog_key"
      ],
      "title": "SmartDeferral",
      "type": "object"
    },
    "StrategyCaseResult": {
      "additionalProperties": false,
      "description": "一个策略在一个 P0-18 case 上的可复核结果。\n\n``source_case`` 和 ``source_trace_events`` 是原始证据的内嵌副本；\n``projection_events`` 只描述策略如何消费这些事件，不改变观察终态、工具\n能力或安全事实。这样脱离临时目录仍可从 P0-19 JSON 逐例复核结论。",
      "properties": {
        "strategy": {
          "$ref": "#/$defs/P019Strategy"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/EvalCategory"
        },
        "source_trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Trace Id",
          "type": "string"
        },
        "strategy_trace_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Strategy Trace Id",
          "type": "string"
        },
        "expected_outcome": {
          "$ref": "#/$defs/EvalOutcome"
        },
        "observed_outcome": {
          "$ref": "#/$defs/EvalOutcome"
        },
        "evaluation_passed": {
          "title": "Evaluation Passed",
          "type": "boolean"
        },
        "task_completed": {
          "title": "Task Completed",
          "type": "boolean"
        },
        "plan_evaluated": {
          "title": "Plan Evaluated",
          "type": "boolean"
        },
        "plan_legal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Legal"
        },
        "recovery_applicable": {
          "title": "Recovery Applicable",
          "type": "boolean"
        },
        "recovery_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recovery Success"
        },
        "successful_recovery": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Successful Recovery"
        },
        "tool_error_count": {
          "minimum": 0,
          "title": "Tool Error Count",
          "type": "integer"
        },
        "unexpected_tool_error_count": {
          "minimum": 0,
          "title": "Unexpected Tool Error Count",
          "type": "integer"
        },
        "step_count": {
          "minimum": 0,
          "title": "Step Count",
          "type": "integer"
        },
        "tool_step_count": {
          "minimum": 0,
          "title": "Tool Step Count",
          "type": "integer"
        },
        "derived_control_overhead_steps": {
          "minimum": 0,
          "title": "Derived Control Overhead Steps",
          "type": "integer"
        },
        "token_usage": {
          "$ref": "#/$defs/TokenSummary"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "resource": {
          "$ref": "#/$defs/ResourceObservation"
        },
        "replan_count": {
          "minimum": 0,
          "title": "Replan Count",
          "type": "integer"
        },
        "retry_count": {
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "approval_resume_count": {
          "minimum": 0,
          "title": "Approval Resume Count",
          "type": "integer"
        },
        "zero_tolerance": {
          "$ref": "#/$defs/ZeroToleranceMetrics"
        },
        "failure_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "source_case": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Source Case",
          "type": "object"
        },
        "source_trace_events": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "minItems": 1,
          "title": "Source Trace Events",
          "type": "array"
        },
        "projection_events": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "minItems": 1,
          "title": "Projection Events",
          "type": "array"
        }
      },
      "required": [
        "strategy",
        "case_id",
        "category",
        "source_trace_id",
        "strategy_trace_id",
        "expected_outcome",
        "observed_outcome",
        "evaluation_passed",
        "task_completed",
        "plan_evaluated",
        "plan_legal",
        "recovery_applicable",
        "recovery_success",
        "successful_recovery",
        "tool_error_count",
        "unexpected_tool_error_count",
        "step_count",
        "tool_step_count",
        "derived_control_overhead_steps",
        "token_usage",
        "latency_ms",
        "resource",
        "replan_count",
        "retry_count",
        "approval_resume_count",
        "zero_tolerance",
        "source_case",
        "source_trace_events",
        "projection_events"
      ],
      "title": "StrategyCaseResult",
      "type": "object"
    },
    "StrategySummary": {
      "additionalProperties": false,
      "description": "按策略从 60 条逐例结果重新汇总的对照表行。",
      "properties": {
        "strategy": {
          "$ref": "#/$defs/P019Strategy"
        },
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "evaluation_pass_count": {
          "minimum": 0,
          "title": "Evaluation Pass Count",
          "type": "integer"
        },
        "evaluation_accuracy_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evaluation Accuracy Rate",
          "type": "number"
        },
        "positive_case_count": {
          "minimum": 0,
          "title": "Positive Case Count",
          "type": "integer"
        },
        "task_completion_count": {
          "minimum": 0,
          "title": "Task Completion Count",
          "type": "integer"
        },
        "task_completion_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Task Completion Rate",
          "type": "number"
        },
        "plan_evaluated_count": {
          "minimum": 0,
          "title": "Plan Evaluated Count",
          "type": "integer"
        },
        "plan_legal_count": {
          "minimum": 0,
          "title": "Plan Legal Count",
          "type": "integer"
        },
        "plan_legal_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Plan Legal Rate",
          "type": "number"
        },
        "recovery_case_count": {
          "minimum": 0,
          "title": "Recovery Case Count",
          "type": "integer"
        },
        "recovery_terminal_correct_count": {
          "minimum": 0,
          "title": "Recovery Terminal Correct Count",
          "type": "integer"
        },
        "recovery_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recovery Rate",
          "type": "number"
        },
        "successful_recovery_case_count": {
          "minimum": 0,
          "title": "Successful Recovery Case Count",
          "type": "integer"
        },
        "successful_recovery_count": {
          "minimum": 0,
          "title": "Successful Recovery Count",
          "type": "integer"
        },
        "successful_recovery_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Successful Recovery Rate",
          "type": "number"
        },
        "tool_error_count": {
          "minimum": 0,
          "title": "Tool Error Count",
          "type": "integer"
        },
        "unexpected_tool_error_count": {
          "minimum": 0,
          "title": "Unexpected Tool Error Count",
          "type": "integer"
        },
        "step_count_total": {
          "minimum": 0,
          "title": "Step Count Total",
          "type": "integer"
        },
        "step_count_mean": {
          "minimum": 0,
          "title": "Step Count Mean",
          "type": "number"
        },
        "step_count_p50": {
          "minimum": 0,
          "title": "Step Count P50",
          "type": "number"
        },
        "step_count_p95": {
          "minimum": 0,
