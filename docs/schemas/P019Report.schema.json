      },
      "required": [
        "strategy",
        "case_count",
        "evaluation_pass_count",
        "evaluation_accuracy_rate",
        "positive_case_count",
        "task_completion_count",
        "task_completion_rate",
        "plan_evaluated_count",
        "plan_legal_count",
        "plan_legal_rate",
        "recovery_case_count",
        "recovery_terminal_correct_count",
        "recovery_rate",
        "successful_recovery_case_count",
        "successful_recovery_count",
        "successful_recovery_rate",
        "tool_error_count",
        "unexpected_tool_error_count",
        "step_count_total",
        "step_count_mean",
        "step_count_p50",
        "step_count_p95",
        "tool_step_count_total",
        "token_usage",
        "latency",
        "resource",
        "zero_tolerance"
      ],
      "title": "StrategySummary",
      "type": "object"
    },
    "TokenSummary": {
      "additionalProperties": false,
      "description": "Token 汇总和可观测性标记；离线源没有模型调用时不声称测得 Token。",
      "properties": {
        "observed": {
          "default": false,
          "title": "Observed",
          "type": "boolean"
        },
        "model_call_count": {
          "minimum": 0,
          "title": "Model Call Count",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "source": {
          "default": "not_observed",
          "enum": [
            "p018_trace",
            "online_trace",
            "not_observed"
          ],
          "title": "Source",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "model_call_count",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "note"
      ],
      "title": "TokenSummary",
      "type": "object"
    },
    "ZeroToleranceMetrics": {
      "additionalProperties": false,
      "description": "P0-18 零容忍安全指标；所有字段都必须由逐例事实重新汇总。",
