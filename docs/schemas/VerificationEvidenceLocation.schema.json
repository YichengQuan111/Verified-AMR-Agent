      "title": "Line"
    },
    "citation": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Citation",
      "type": "string"
    },
    "excerpt": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Excerpt",
      "type": "string"
    }
  },
  "required": [
