# P0-20 API 镜像只承载 FastAPI 与持久化边界；本地 Qwen 不复制进镜像。
FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# API 镜像只安装 HTTP/数据库/配置边界的锁定依赖；本地 Embedding 与 Fast 模型仍在宿主机，
# 因而不会把 sentence-transformers、PyTorch 或任何模型权重带进 Compose。完整 P0 运行环境
# 仍由仓库根目录 requirements.lock 管理，二者的版本取自同一份锁定结果。
COPY infra/requirements.api.lock /app/requirements.api.lock
# 基础镜像已由 digest 固定其 pip 版本；require-hashes 同时约束全部传递依赖和 wheel，
# 任一缺失/漂移都会使镜像构建失败，而不是在发布时重新解析出另一棵依赖树。
RUN python -m pip install --no-cache-dir --require-hashes -r /app/requirements.api.lock

COPY . /app

# API 不需要 root 权限；模型、数据库密码和主机路径均通过运行时配置注入。
RUN addgroup --system amr \
    && adduser --system --ingroup amr amr \
    && chown -R amr:amr /app
USER amr

EXPOSE 8000

# compose.yaml 覆盖此默认命令，以便先执行幂等迁移并再启动 Uvicorn。
CMD ["python", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
